# ==============================================================================
# Production Environment Configuration for Dressnio
# Generated based on DOMAIN-SETUP.md Playbook
# ==============================================================================

APP_NAME=Dressnio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dressnio.softcredible.com

# Nuxt 4 Public Runtime API base
NUXT_PUBLIC_API_BASE=https://dressnio.softcredible.com/api

# Isolated Database Credentials
DB_CONNECTION=mysql
DB_HOST=dressnio-db-1
DB_PORT=3306
DB_DATABASE=dressnio
DB_USERNAME=dressnio
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session / Cache / Queue
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@dressnio.com
ADMIN_PASSWORD=

# Sanctum & Allowed Origins
SANCTUM_TOKEN_EXPIRATION=10080
FRONTEND_URL=https://dressnio.softcredible.com
ADMIN_URL=https://dressnio.softcredible.com/admin

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@dressnio.softcredible.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS / Courier / Payment Gateways
QUICKSMS_API_KEY=
QUICKSMS_SECRET_KEY=
QUICKSMS_CALLER_ID=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
BKASH_NUMBER=01974784848
NAGAD_NUMBER=01974784848
