APP_NAME=Dressnio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dressnio_admin
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Admin bootstrap credentials (used by UserTableSeeder)
ADMIN_EMAIL=admin@dressnio.com
ADMIN_PASSWORD=dressnio@2026

# Sanctum token lifetime in minutes (7 days default)
SANCTUM_TOKEN_EXPIRATION=10080

# Frontend app origins (CORS/stateful)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# SMS (QuickSMS) — used for OTP delivery; never ship keys to the client
QUICKSMS_API_KEY=
QUICKSMS_SECRET_KEY=
QUICKSMS_CALLER_ID=

# SteadFast courier credentials
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# bKash / Nagad merchant numbers shown on checkout (managed via admin Settings too)
BKASH_NUMBER=
NAGAD_NUMBER=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dressnio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
